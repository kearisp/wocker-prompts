{
    "name": "@wocker/prompts",
    "type": "commonjs",
    "version": "1.0.1",
    "author": "Kris Papercut <krispcut@gmail.com>",
    "description": "CLI prompts for wocker",
    "license": "MIT",
    "main": "./lib/index.js",
    "types": "./lib/index.d.ts",
    "keywords": [
        "wocker"
    ],
    "homepage": "https://github.com/kearisp/wocker-prompts#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/kearisp/wocker-prompts.git"
    },
    "bugs": {
