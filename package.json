        "@types/jest": "^30.0.0",
        "@types/mute-stream": "^0.0.4",
        "@types/node": "^24.12.2",
        "jest": "^30.4.2",
        "make-coverage-badge": "^1.2.0",
        "mute-stream": "^2.0.0",
        "ts-jest": "^29.4.9",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.3"
